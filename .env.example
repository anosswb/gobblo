# Copy to .env.local and fill in. NEVER commit real values (the repo is public).
# In CI, the same names are GitHub repo secrets (docs/19-analytics.md).

# PostHog (EU cloud) project API key, starts with phc_. Empty = analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
# PostHog host. Empty = https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=
# Sentry DSN (EU region project "gobblo"). Empty = crash reports off.
EXPO_PUBLIC_SENTRY_DSN=
# Sentry organization auth token. BUILD TIME ONLY (source map upload). Secret: never in app code.
# Empty = no upload, the build still works.
SENTRY_AUTH_TOKEN=
# Sentry organization slug (optional; needed for the upload if the token does not carry it).
SENTRY_ORG=
