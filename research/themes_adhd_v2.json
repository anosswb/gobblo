{
 "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show). v2 (2026-11-06): adds themes found by reading the Google Play, Goblin Tools and Hacker News rows by hand.",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "pricing",
   "label": "Price and paywalls",
   "kind": "complaint",
   "patterns": [
    "\\bexpensive\\b",
    "\\boverpriced\\b",
    "\\bpric(e|es|ey|ing)\\b",
    "\\bpaywall",
    "\\bsubscription\\b",
    "\\bper (month|seat|user)\\b",
    "\\bfree (plan|tier|version)\\b",
    "\\bupgrade to\\b",
    "\\bpremium\\b",
    "\\bnot worth\\b",
    "\\bcost(s|ly)?\\b"
   ]
  },
  {
   "id": "billing",
   "label": "Billing, cancelling and refunds",
   "kind": "complaint",
   "patterns": [
    "\\bcharged\\b",
    "\\brefund",
    "\\bcancel(l?ing|l?ed|lation)?\\b",
    "\\bauto.?renew",
    "\\bhidden (fee|charge)",
    "\\bbilling\\b",
    "\\bscam\\b",
    "\\bcredit card\\b"
   ]
  },
  {
   "id": "bugs",
   "label": "Bugs and crashes",
   "kind": "complaint",
   "patterns": [
    "\\bcrash(es|ed|ing)?\\b",
    "\\bbugs?\\b",
    "\\bbuggy\\b",
    "\\bglitch",
    "\\bfreez(e|es|ing)\\b",
    "\\bbroken\\b",
    "\\b(doesn'?t|does not|stopped) work",
    "\\bnot working\\b",
    "\\berror\\b"
   ]
  },
  {
   "id": "performance",
   "label": "Slow, laggy, heavy",
   "kind": "complaint",
   "patterns": [
    "\\bslow\\b",
    "\\blag(gy|s)?\\b",
    "\\bloading\\b",
    "\\btakes forever\\b",
    "\\bbattery\\b",
    "\\bsluggish\\b",
    "\\bheavy\\b"
   ]
  },
  {
   "id": "data",
   "label": "Sync and lost data",
   "kind": "complaint",
   "patterns": [
    "\\bsync(ing|s|ed)?\\b",
    "\\blost (my|all)\\b",
    "\\bdisappear",
    "\\bdata loss\\b",
    "\\bwiped\\b",
    "\\bbackup\\b",
    "\\bduplicat"
   ]
  },
