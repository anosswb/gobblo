    "\\bcluttered\\b",
    "\\btakes too long\\b",
    "\\btoo much (time|setup)\\b"
   ]
  },
  {
   "id": "adhd-notifs",
   "label": "Reminders and notifications",
   "kind": "complaint",
   "patterns": [
