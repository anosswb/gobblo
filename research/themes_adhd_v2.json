    "\\bcountdown\\b",
    "\\bpomodoro\\b"
   ]
  },
  {
   "id": "adhd-guilt",
   "label": "Guilt, streaks and shame",
   "kind": "complaint",
   "patterns": [
    "\\bguilt",
    "\\bstreak",
    "\\bashamed\\b",
    "\\bshame\\b",
    "\\bpunish",
    "\\bfail(ed|ing)? (me|again)\\b"
   ]
  },
  {
   "id": "sync-widgets",
   "label": "Sync, calendar and widgets",
   "kind": "complaint",
   "patterns": [
    "\\bsync",
    "\\bcalendar\\b",
    "\\bwidget",
    "\\bapple watch\\b",
    "\\bwatch app\\b"
   ]
  },
  {
   "id": "childish",
   "label": "Feels childish / not for adults",
   "kind": "complaint",
   "patterns": [
    "\\bchildish\\b",
    "\\bfor kids\\b",
    "\\bbabyish\\b",
    "\\binfantiliz"
   ]
  },
  {
   "id": "adhd-helps",
   "label": "Says it helps their ADHD",
   "kind": "praise",
   "patterns": [
    "\\badhd\\b",
    "\\bneurodivergent\\b",
    "\\bexecutive (function|dysfunction)\\b",
    "\\bautis"
   ]
  },
  {
   "id": "android-second",
   "label": "Android feels second-class (missing features, broken sync/notifications)",
   "kind": "complaint",
   "patterns": [
    "\\bandroid (app|version|user|phone|device)s?\\b",
    "\\bon (my )?android\\b",
    "\\bfor android\\b",
    "\\bsamsung\\b",
    "\\bfeature parity\\b",
    "\\bonly available on apple\\b",
    "\\bnon.apple\\b"
   ]
  },
  {
   "id": "paid-then-sub",
   "label": "Paid once, then asked to pay again (switch to subscription)",
   "kind": "complaint",
   "patterns": [
    "\\b(paid|bought|purchased) (for )?(this|the|it)( app| full version| pro version)?\\b.{0,120}\\b(subscri|monthly|pay again|pay more)",
    "\\bone.?time (fee|purchase|payment)\\b.{0,120}\\bsubscri",
    "\\bwhy am i paying again\\b",
    "\\bbooting users who paid\\b",
    "\\bpay for it again\\b",
    "\\bnow (they|you) want me to (buy|pay|subscribe)",
    "\\bnow it wants me to subscribe\\b",
    "\\bwith an exciting addition of a subscription\\b",
    "\\bcanceled for favor of a subscription\\b"
   ]
  },
  {
   "id": "basic-paywalled",
   "label": "Basic features paywalled (recurring tasks, subtasks, reminders)",
   "kind": "complaint",
   "patterns": [
    "\\b(basic|simple|basics)\\b.{0,60}\\b(paywall|premium|pay|pro)\\b",
    "\\b(recurring|repeat(ing)?|daily/weekly|weekly events|sub ?tasks)\\b.{0,60}\\b(paywall|premium|pay|pro|locked)\\b",
    "\\blocked (down|behind)\\b",
    "\\buseless if you don'?t pay\\b",
    "\\bwithout (first )?paying\\b"
   ]
  },
  {
   "id": "setup-then-paywall",
   "label": "Paywall only after a long setup / quiz",
   "kind": "complaint",
   "patterns": [
    "\\b(setup|set.up|quiz|questions|intro|onboarding)\\b.{0,120}\\b(pay ?wall|paid (app|plan)|subscription|pay)\\b",
    "\\bbefore telling you it'?s a paid app\\b",
    "\\buntil i'?d completed the intro\\b",
    "\\bonce you'?ve done all the setup work\\b"
   ]
  },
  {
   "id": "review-too-early",
   "label": "Asks for a rating before you have used it",
   "kind": "complaint",
   "patterns": [
    "\\b(rate|rating|review)\\b.{0,60}\\b(before|30s|after install|first hour|on install|getting started)\\b",
    "\\b(before|30s after).{0,40}\\b(rate|rating|review)\\b",
    "\\bbegs for a rating\\b",
    "\\basked (me )?(twice )?to review\\b",
    "\\b(rating|review|rate)\\b.{0,80}\\bbefore\\b",
    "\\bbefore\\b.{0,60}\\brate (you|it)\\b",
    "\\brating screen\\b"
   ]
  },
  {
   "id": "ai-wrong",
   "label": "AI that gets it wrong or costs more effort",
   "kind": "complaint",
   "patterns": [
    "\\bthe ai\\b",
    "\\bai (feature|assistant|is|sucks)\\b",
    "\\bin (swedish|spanish|cyrillic)\\b",
    "\\bcyrillic\\b",
    "\\bestimated time\\b",
    "\\bai slop\\b"
   ]
  },
  {
   "id": "lost-progress",
   "label": "Lost everything (lists, pet, streak) after an update or logout",
